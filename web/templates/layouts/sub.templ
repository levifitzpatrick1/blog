package layouts

import "strings"

type NavLink struct {
	Path  string
	Label string
}

templ Sub(title, currentPath string, scripts ...templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
			<link href="/static/css/style.css" rel="stylesheet"/>
			<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"/>
			<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>
			<script src="https://unpkg.com/htmx.org@2.0.4" crossorigin="anonymous"></script>
			for _, s := range scripts {
				@s
			}
		</head>
		<body class="bg-background text-primary min-h-screen">
			<nav class="sticky top-0 z-50 bg-background border-b border-border">
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
					<div class="flex justify-between items-center h-16">
						<div class="flex-shrink-0">
							<a
								href="/"
								class="text-xl font-bold text-primary hover:text-accent transition-colors duration-200"
							>
								Levi Fitzpatrick
							</a>
						</div>
						<div class="hidden md:flex items-center space-x-6">
							@navButton(NavLink{Path: "/frc", Label: "FRC"}, currentPath)
							@navButton(NavLink{Path: "/blog", Label: "Blog"}, currentPath)
							@navButton(NavLink{Path: "/packout/", Label: "Packout"}, currentPath)
						</div>
						<div class="md:hidden">
							<button
								onclick="document.getElementById('mobile-menu').classList.toggle('hidden')"
								class="text-primary transition-colors p-2"
								aria-label="Toggle menu"
							>
								<span class="material-symbols-outlined text-2xl leading-none">menu</span>
							</button>
						</div>
					</div>
				</div>
				<div
					id="mobile-menu"
					class="hidden md:hidden border-t border-border bg-background"
				>
					<div class="px-4 py-4 space-y-2">
						@navButtonMobile(NavLink{Path: "/frc", Label: "FRC"}, currentPath)
						@navButtonMobile(NavLink{Path: "/blog", Label: "Blog"}, currentPath)
						@navButtonMobile(NavLink{Path: "/packout/", Label: "Packout"}, currentPath)
					</div>
				</div>
			</nav>
			<main class="p-4 sm:p-6 md:p-8 max-w-7xl mx-auto">
				{ children... }
			</main>
		</body>
	</html>
}

templ navButton(link NavLink, currentPath string) {
	{{
		isActive := false
		if link.Path == "/blog" {
			isActive = strings.HasPrefix(currentPath, "/blog")
		} else {
			isActive = (currentPath == link.Path)
		}
	}}
	<a
		href={ templ.URL(link.Path) }
		class={ templ.Classes(
			"font-semibold text-base transition-colors duration-200",
			templ.KV("text-accent", isActive),
			templ.KV("text-secondary hover:text-accent", !isActive),
		) }
	>
		{ link.Label }
	</a>
}

templ navButtonMobile(link NavLink, currentPath string) {
	{{
		isActive := false
		if link.Path == "/blog" {
			isActive = strings.HasPrefix(currentPath, "/blog")
		} else {
			isActive = (currentPath == link.Path)
		}
	}}
	<a
		href={ templ.URL(link.Path) }
		class={ templ.Classes(
			"block py-2 font-semibold text-base transition-colors duration-200",
			templ.KV("text-accent", isActive),
			templ.KV("text-secondary hover:text-accent", !isActive),
		) }
	>
		{ link.Label }
	</a>
}
