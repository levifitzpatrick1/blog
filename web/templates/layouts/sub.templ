package layouts

import "strings"

type NavLink struct {
	Path  string
	Label string
}

templ Sub(title, currentPath string, scripts ...templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
			<link href="/static/css/style.css" rel="stylesheet"/>
			<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"/>
			<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>
			<script src="https://unpkg.com/htmx.org@2.0.4" crossorigin="anonymous"></script>
			<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
			for _, s := range scripts {
				@s
			}
		</head>
		<body class="bg-background text-primary min-h-screen" x-data="{ mobileMenuOpen: false, scrolled: false }" @scroll.window="scrolled = window.pageYOffset > 20">
			<nav class="nav-material sticky top-0 z-50 transition-all duration-300" :class="{ 'shadow-lg': scrolled }">
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
					<div class="flex justify-between items-center h-16">
						<div class="flex-shrink-0">
							<a
								href="/"
								class="text-2xl font-bold text-gradient transition-transform duration-300"
							>
								Levi Fitzpatrick
							</a>
						</div>
						<div class="hidden md:flex items-center space-x-4">
							@navButton(NavLink{Path: "/frc", Label: "FRC"}, currentPath)
							@navButton(NavLink{Path: "/blog", Label: "Blog"}, currentPath)
						</div>
						<div class="md:hidden">
							<button
								@click="mobileMenuOpen = !mobileMenuOpen"
								class="text-primary transition-colors p-2"
								aria-label="Toggle menu"
							>
								<span class="material-symbols-outlined text-2xl leading-none" x-show="!mobileMenuOpen">menu</span>
								<span class="material-symbols-outlined text-2xl leading-none" x-show="mobileMenuOpen">close</span>
							</button>
						</div>
					</div>
				</div>
				<div
					x-show="mobileMenuOpen"
					@click.away="mobileMenuOpen = false"
					x-transition:enter="transition ease-out duration-200"
					x-transition:enter-start="opacity-0 transform scale-95"
					x-transition:enter-end="opacity-100 transform scale-100"
					x-transition:leave="transition ease-in duration-150"
					x-transition:leave-start="opacity-100 transform scale-100"
					x-transition:leave-end="opacity-0 transform scale-95"
					class="md:hidden border-t border-border"
				>
					<div class="px-4 py-4 space-y-2">
						@navButtonMobile(NavLink{Path: "/frc", Label: "FRC"}, currentPath)
						@navButtonMobile(NavLink{Path: "/blog", Label: "Blog"}, currentPath)
					</div>
				</div>
			</nav>
			<main class="p-4 sm:p-6 md:p-8 max-w-7xl mx-auto">
				{ children... }
			</main>
		</body>
	</html>
}

templ navButton(link NavLink, currentPath string) {
	{{
		isActive := false
		if link.Path == "/blog" {
			isActive = strings.HasPrefix(currentPath, "/blog")
		} else {
			isActive = (currentPath == link.Path)
		}

		baseClasses := "relative font-bold py-2 px-6 rounded-md transition-all duration-300"
		var stateClasses string
		if isActive {
			stateClasses = "gradient-accent text-card-background shadow-lg"
		} else {
			stateClasses = "text-accent hover:ring-2 hover:ring-accent"
		}
	}}
	<a
		href={ templ.URL(link.Path) }
		class={ templ.Classes(baseClasses, stateClasses) }
	>
		{ link.Label }
	</a>
}

templ navButtonMobile(link NavLink, currentPath string) {
	{{
		isActive := false
		if link.Path == "/blog" {
			isActive = strings.HasPrefix(currentPath, "/blog")
		} else {
			isActive = (currentPath == link.Path)
		}

		baseClasses := "block w-full text-left font-bold py-3 px-4 rounded-full transition-all duration-300"
		var stateClasses string
		if isActive {
			stateClasses = "gradient-accent text-white"
		} else {
			stateClasses = "text-accent hover:ring-2 hover:ring-accent"
		}
	}}
	<a
		href={ templ.URL(link.Path) }
		class={ templ.Classes(baseClasses, stateClasses) }
	>
		{ link.Label }
	</a>
}
