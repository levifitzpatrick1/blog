package home

templ ContactButton() {
	<div
		class="fixed bottom-8 right-8 z-50"
		x-data="{ open: false }"
		@click.away="open = false"
	>
		<button
			@click="open = !open"
			class="bg-background text-accent border-2 border-accent rounded-full shadow-lg transition-all duration-300 group flex items-center justify-center"
			:class="open ? 'p-4' : 'px-6 py-4'"
			aria-label="Contact options"
			x-bind:aria-expanded="open"
		>
			<span x-show="!open" class="font-semibold">Contact</span>
			<span x-show="open" class="material-symbols-outlined text-2xl leading-none">expand_more</span>
		</button>

		<div
			x-show="open"
			x-transition:enter="transition ease-out duration-300"
			x-transition:enter-start="opacity-0 transform translate-y-4 scale-95"
			x-transition:enter-end="opacity-100 transform translate-y-0 scale-100"
			x-transition:leave="transition ease-in duration-200"
			x-transition:leave-start="opacity-100 transform translate-y-0 scale-100"
			x-transition:leave-end="opacity-0 transform translate-y-4 scale-95"
			class="absolute bottom-20 right-0 space-y-3 min-w-max"
		>
			<div class="material-card p-4 space-y-3">
				<a
					href="https://github.com/levifitzpatrick1"
					target="_blank"
					rel="noopener noreferrer"
					class="flex items-center space-x-3 text-primary hover:text-accent transition-colors duration-300 group"
				>
					<div class="w-10 h-10 gradient-accent rounded-full flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
						<i class="fa-brands fa-github text-2xl text-black"></i>
					</div>
					<span class="font-semibold">GitHub</span>
				</a>

				<div x-data="{ feedback: 'Personal Email', copied: false }">
					<button
						@click="
							navigator.clipboard.writeText('levifitzpatrick1@gmail.com');
							feedback = 'Copied!';
							copied = true;
							setTimeout(() => {
								feedback = 'Personal Email';
								copied = false;
							}, 2000);
						"
						class="flex items-center space-x-3 text-primary hover:text-accent transition-colors duration-300 group w-full text-left"
					>
						<div class="w-10 h-10 rounded-full flex items-center justify-center transition-transform duration-300 bg-gradient-to-r from-cyan-500 to-blue-600">
							<span class="material-symbols-outlined text-xl text-background leading-none">email</span>
						</div>
						<div class="flex-1">
							<span class="font-semibold block" x-text="feedback"></span>
							<span class="text-xs text-secondary" x-show="!copied">levifitzpatrick1@gmail.com</span>
							<span class="text-xs text-accent font-semibold" x-show="copied">Copied to clipboard</span>
						</div>
					</button>
				</div>

				<div x-data="{ feedback: 'FRC Email', copied: false }">
					<button
						@click="
							navigator.clipboard.writeText('levi@2064.team');
							feedback = 'Copied!';
							copied = true;
							setTimeout(() => {
								feedback = 'FRC Email';
								copied = false;
							}, 2000);
						"
						class="flex items-center space-x-3 text-primary hover:text-accent transition-colors duration-300 group w-full text-left"
					>
						<div class="w-10 h-10 rounded-full flex items-center justify-center transition-transform duration-300 bg-gradient-to-r from-cyan-500 to-blue-600">
							<span class="material-symbols-outlined text-xl text-background leading-none">email</span>
						</div>
						<div class="flex-1">
							<span class="font-semibold block" x-text="feedback"></span>
							<span class="text-xs text-secondary" x-show="!copied">levi@2064.team</span>
							<span class="text-xs text-accent font-semibold" x-show="copied">Copied to clipboard</span>
						</div>
					</button>
				</div>
			</div>
		</div>
	</div>
}
