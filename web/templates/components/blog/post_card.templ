package blog

import "github.com/levifitzpatrick1/levifitzpatrick.page/internal/utils"

templ PostCard(post utils.Post) {
	<a href={ templ.URL("/blog/" + post.Slug) } class="group block py-6 border-b border-border hover:border-accent/40 transition-colors duration-200">
		<div class="flex flex-col md:flex-row md:items-baseline justify-between gap-2">
			<h3 class="text-xl font-semibold text-primary group-hover:text-accent transition-colors duration-200">
				{ post.Title }
			</h3>
			<span class="text-sm text-secondary shrink-0">
				{ post.CreateDate.Format("January 2, 2006") }
			</span>
		</div>
		<p class="text-secondary text-base mt-2 line-clamp-2 leading-relaxed">
			{ post.Blurb }
		</p>
	</a>
}
