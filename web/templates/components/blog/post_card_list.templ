package blog

import "github.com/levifitzpatrick1/blog/internal/utils"

templ PostCardList(posts []utils.Post) {
	<div class="mx-auto max-w-7xl px-4">
		<div class="post-list grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-8">
			for _, post := range posts {
				<div>
					@PostCard(post)
				</div>
			}
		</div>
		if len(posts) == 0 {
			<div class="text-center py-16">
				<div class="material-card inline-block px-12 py-8">
					<svg class="w-16 h-16 mx-auto mb-4 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
					</svg>
					<p class="text-xl text-secondary font-medium">No posts found</p>
					<p class="text-sm text-secondary mt-2">Try adjusting your search</p>
				</div>
			</div>
		}
	</div>
}
