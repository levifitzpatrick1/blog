package frc

type AccordionItem struct {
	Title   string
	Content templ.Component
}

templ Accordion(items []AccordionItem) {
	<div class="space-y-2">
		for _, item := range items {
			@AccordionItemComponent(item)
		}
	</div>
}

templ AccordionItemComponent(item AccordionItem) {
	<details class="border border-border rounded-lg group">
		<summary class="flex items-center justify-between w-full p-4 font-medium text-left cursor-pointer list-none select-none">
			<span>{ item.Title }</span>
			<span class="material-symbols-outlined text-base shrink-0 transition-transform duration-200 leading-none group-open:rotate-180">expand_more</span>
		</summary>
		<div class="p-4 border-t border-border">
			@item.Content
		</div>
	</details>
}
