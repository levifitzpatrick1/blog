package frc

type AccordionItem struct {
	Title   string
	Content templ.Component
}

templ Accordion(items []AccordionItem) {
	<div x-data="{ openItem: null }" class="space-y-2">
		for i, item := range items {
			@AccordionItemComponent(item, i)
		}
	</div>
}

templ AccordionItemComponent(item AccordionItem, index int) {
	<div class="border rounded-lg">
		<h2>
			<button
				@click="openItem = openItem === index ? null : index"
				type="button"
				class="flex items-center justify-between w-full p-4 font-medium text-left"
				:aria-expanded="openItem === index"
			>
				<span>{ item.Title }</span>
				<span
					class="material-symbols-outlined text-base shrink-0 transition-transform duration-200 leading-none"
					:class="{ 'rotate-180': openItem === index }"
				>expand_more</span>
			</button>
		</h2>
		<div x-show="openItem === index" x-collapse>
			<div class="p-4 border-t">
				@item.Content
			</div>
		</div>
	</div>
}
