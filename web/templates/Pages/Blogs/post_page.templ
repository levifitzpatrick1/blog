package blogs

import "github.com/levifitzpatrick1/levifitzpatrick.page/internal/utils"

templ PostPage(data utils.Post) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ data.Title }</title>
			<link rel="stylesheet" href="/static/css/style.css"/>
			<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
			<script src="https://unpkg.com/htmx.org@2.0.4" crossorigin="anonymous"></script>
		</head>
		<body class="bg-background text-primary min-h-screen">
			<div class="max-w-3xl mx-auto px-4 py-8 fade-in">
				<div class="mb-8">
					<a
						href="/blog"
						class="inline-flex items-center text-secondary hover:text-accent font-semibold transition-colors duration-200 group"
					>
						<span class="material-symbols-outlined text-xl mr-1 leading-none">arrow_back</span>
						<span>Back to Blog</span>
					</a>
				</div>

				<article class="prose prose-invert lg:prose-xl max-w-none">
					<header class="mb-8 pb-6 border-b border-border">
						<h1 class="text-3xl md:text-4xl font-bold text-primary mb-3 leading-tight">
							{ data.Title }
						</h1>
						<div class="flex flex-wrap items-center gap-4 text-sm text-secondary">
							<div class="flex items-center">
								<span>Levi Fitzpatrick</span>
							</div>
							<span>&bull;</span>
							<div class="flex items-center">
								<span>{ data.CreateDate.Format("January 2, 2006") }</span>
							</div>
							if !data.ModifyDate.IsZero() && !data.ModifyDate.Equal(data.CreateDate) {
								<span>&bull;</span>
								<div class="flex items-center">
									<span>Updated: { data.ModifyDate.Format("January 2, 2006") }</span>
								</div>
							}
						</div>
					</header>

					<div class="text-primary leading-relaxed">
						@templ.Raw(data.HTMLContent)
					</div>
				</article>
			</div>
		</body>
	</html>
}
