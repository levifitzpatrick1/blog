package blogs

import "github.com/levifitzpatrick1/blog/web/templates/layouts"
import "github.com/levifitzpatrick1/blog/internal/utils"
import "github.com/levifitzpatrick1/blog/web/templates/components/blog"
import "strings"
import "sort"

templ Blogs(data []utils.Post) {
	@layouts.Sub("Blog", "/blog", layouts.HtmxScript()) {
		<body class="bg-background text-primary min-h-screen">
			<div class="my-8 flex justify-center px-4" x-data="{ searching: false, searchTerm: '', setTag(tag) { this.searchTerm = tag; this.$nextTick(() => { const el = document.querySelector('input[name=search]'); if (el) el.dispatchEvent(new Event('input', { bubbles: true })); }) } }" x-init="setTimeout(() => searching = false, 100)">
				<div class="w-full mx-auto md:w-2/3 lg:w-1/2">
					<div class="relative">
						<input
							class="input-material w-full text-primary transition-all duration-300"
							type="search"
							name="search"
							placeholder="Search for a post..."
							x-model="searchTerm"
							hx-post="/search"
							hx-trigger="input changed delay:120ms, search"
							hx-target="#blog-results"
							hx-indicator="#search-indicator"
							hx-swap="innerHTML transition:true"
							x-on:htmx:before-request="searching = true"
							x-on:htmx:after-settle="searching = false"
						/>
						<div class="absolute right-4 top-1/2 transform -translate-y-1/2">
							<svg
								id="search-indicator"
								class="htmx-indicator w-6 h-6 text-accent"
								xmlns="http://www.w3.org/2000/svg"
								fill="none"
								viewBox="0 0 24 24"
								x-show="searching"
								x-transition:enter="transition ease-out duration-200"
								x-transition:enter-start="opacity-0 scale-50"
								x-transition:enter-end="opacity-100 scale-100"
								x-transition:leave="transition ease-in duration-150"
								x-transition:leave-start="opacity-100 scale-100"
								x-transition:leave-end="opacity-0 scale-50"
							>
								<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
								<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z">
									<animateTransform
										attributeName="transform"
										attributeType="XML"
										type="rotate"
										from="0 12 12"
										to="360 12 12"
										dur="1s"
										repeatCount="indefinite"
									/>
								</path>
							</svg>
							<svg
								class="w-6 h-6 text-secondary"
								xmlns="http://www.w3.org/2000/svg"
								fill="none"
								viewBox="0 0 24 24"
								stroke="currentColor"
								x-show="!searching"
							>
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
							</svg>
						</div>
					</div>

					{{
						tagSet := map[string]bool{}
						var tags []string
						for _, p := range data {
							for _, t := range p.Tags {
								l := strings.TrimSpace(t.Name)
								if l == "" {
									continue
								}
								lower := strings.ToLower(l)
								if !tagSet[lower] {
									tagSet[lower] = true
									tags = append(tags, l)
								}
							}
						}
						sort.SliceStable(tags, func(i, j int) bool { return strings.ToLower(tags[i]) < strings.ToLower(tags[j]) })
					}}
					if len(tags) > 0 {
						<div class="mt-6 flex justify-center">
							<div class="flex flex-wrap justify-center gap-3 max-w-3xl">
								for _, tag := range tags {
									<button
										type="button"
										class="px-4 py-2 text-sm rounded-full bg-card-background text-accent border border-accent/20 hover:bg-accent hover:text-white transition"
										:class="{ 'bg-accent text-white border-transparent': searchTerm === $el.dataset.tag }"
										data-tag={ templ.JoinStringErrs(strings.ToLower(tag)) }
										@click="setTag($el.dataset.tag)"
										:aria-pressed="searchTerm === $el.dataset.tag"
									>
										<span class="text-sm font-semibold">{ tag }</span>
									</button>
								}
							</div>
						</div>
					}
				</div>
			</div>

			<div id="blog-results" x-data x-init="setTimeout(() => {}, 200)" x-on:htmx:before-swap="document.querySelectorAll('.post-list .post-card').forEach(el => el.classList.add('htmx-swapping'))" x-on:htmx:after-swap="document.querySelectorAll('.post-list .post-card').forEach(el => el.classList.remove('htmx-swapping'))" class="max-w-7xl mx-auto px-4">
				@blog.PostCardList(data)
			</div>
		</body>
	}
}
