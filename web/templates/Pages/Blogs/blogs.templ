package blogs

import "github.com/levifitzpatrick1/levifitzpatrick.page/web/templates/layouts"
import "github.com/levifitzpatrick1/levifitzpatrick.page/internal/utils"
import "github.com/levifitzpatrick1/levifitzpatrick.page/web/templates/components/blog"

templ Blogs(data []utils.Post) {
	@layouts.Sub("Blog", "/blog", layouts.HtmxScript()) {
		<div class="w-full min-h-screen">
			<div class="my-8 flex justify-center px-4">
				<div class="w-full mx-auto md:w-2/3 lg:w-1/2">
					<div class="relative search-container border-b border-border focus-within:border-accent transition-colors duration-200">
						<input
							class="w-full bg-transparent text-primary py-3 pr-10 focus:outline-none placeholder-secondary/50 text-base"
							type="search"
							name="search"
							placeholder="Search posts..."
							hx-post="/search"
							hx-trigger="input changed delay:120ms, search"
							hx-target="#blog-results"
							hx-indicator="closest .search-container"
							hx-swap="innerHTML transition:true"
						/>
						<div class="absolute right-0 top-1/2 transform -translate-y-1/2 flex items-center justify-center pointer-events-none">
							<span
								id="search-indicator"
								class="htmx-indicator material-symbols-outlined text-xl text-accent animate-spin leading-none"
							>progress_activity</span>
							<span
								id="search-icon"
								class="search-icon material-symbols-outlined text-xl text-secondary/50 leading-none"
							>search</span>
						</div>
					</div>
				</div>
			</div>

			<div id="blog-results" class="max-w-7xl mx-auto px-4">
				@blog.PostCardList(data)
			</div>
		</div>
	}
}
