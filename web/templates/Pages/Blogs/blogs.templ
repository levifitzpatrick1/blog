package blogs

import "github.com/levifitzpatrick1/blog/web/templates/layouts"
import "github.com/levifitzpatrick1/blog/internal/utils"
import "github.com/levifitzpatrick1/blog/web/templates/components/blog"

templ Blogs(data []utils.Post) {
	@layouts.Sub("Blog", "/blog", layouts.HtmxScript()) {
		<body class="bg-background text-primary">
			<div class="my-8 flex justify-center px-4">
				<div class="w-full mx-auto md:w-2/3 lg:w-1/2">
					<input
						class="w-full border-1 border-border bg-card-background text-primary rounded-full py-3 px-5 transition-all duration-300 focus:outline-none focus:border-accent-hover focus:ring-1 focus:ring-accent-hover"
						type="search"
						name="search"
						placeholder="Search for a post..."
						hx-post="/search"
						hx-trigger="input changed delay:5ms, search"
						hx-target="#blogs"
						hx-indicator=".htmx-indicator"
						hx-swap="innerHTML transition:true"
					/>
				</div>
			</div>
			<div id="blogs">
				@blog.PostCardList(data)
			</div>
		</body>
	}
}
