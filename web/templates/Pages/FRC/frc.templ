package Pages

import "github.com/levifitzpatrick1/blog/web/templates/layouts"

templ FRCPage() {
	@layouts.Sub("FRC", "/frc", layouts.HtmxScript()) {
		<body class="bg-background text-primary p-4 sm:p-6 md:p-8">
			<div class="max-w-4xl mx-auto">
				<h1 class="text-4xl font-bold text-primary">FRC Projects</h1>
				<p class="mt-4 text-secondary">
					More content coming soon!
				</p>
			</div>
		</body>
	}
}
