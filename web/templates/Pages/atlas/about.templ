package atlas

templ About() {
	@AtlasLayout("About Us - Atlas Basses") {
		<div class="atlas-container">
			<div class="relative bg-cover bg-center py-20 md:py-32" style="background-image: linear-gradient(rgba(13, 17, 23, 0.7), rgba(13, 17, 23, 0.7)), url('/static/assets/about-header.jpg');">
				<div class="text-center atlas-container">
					<h1 class="text-6xl md:text-7xl lg:text-8xl font-bold text-accent mb-8 tracking-tighter atlas-heading">
						About Atlas Basses
					</h1>
					<p class="text-2xl md:text-3xl text-secondary max-w-3xl mx-auto leading-relaxed px-4 font-light">
						Where precision engineering meets musical artistry.
					</p>
				</div>
			</div>
			<div class="material-card atlas-card mb-24 border-l-4 border-accent text-center">
				<h2 class="text-xl font-bold text-accent mb-4 uppercase tracking-widest">Our Mission</h2>
				<p class="text-3xl md:text-4xl lg:text-5xl text-primary font-bold leading-tight">
					"Engineering instruments that inspire."
				</p>
			</div>
			<div class="atlas-section grid lg:grid-cols-12 gap-12 items-center">
				<div class="lg:col-span-5 order-2 lg:order-1">
					<div class="relative rounded-lg overflow-hidden shadow-2xl">
						<img src="/static/assets/me.jpg" alt="Levi Fitzpatrick" class="w-full h-auto object-cover grayscale"/>
						<div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/50 to-transparent"></div>
						<div class="absolute bottom-6 left-6 text-left p-4">
							<p class="text-white font-bold text-2xl">Levi Fitzpatrick</p>
							<p class="text-accent text-sm uppercase tracking-widest">Founder & Lead Designer</p>
						</div>
					</div>
				</div>
				<div class="lg:col-span-7 order-1 lg:order-2">
					<h3 class="text-4xl md:text-5xl font-bold text-primary mb-8 tracking-tight">The Engineer Behind the Design</h3>
					<div class="prose prose-invert lg:prose-xl max-w-none text-secondary">
						<p class="leading-relaxed mb-6">
							Levi Fitzpatrick has been playing instruments since he was 9 years old. This lifelong connection to music is what eventually led him to explore instrument building.
						</p>
						<p class="leading-relaxed mb-6">
							While he comes from an engineering background, Levi is most drawn to the design and creative aspects of the field. He views engineering not just as a technical discipline, but as a creative toolset.
						</p>
						<p class="leading-relaxed">
							Atlas Basses allows him to combine these two passions: using engineering principles to fuel creative design, resulting in instruments that are unique, functional, and inspiring.
						</p>
					</div>
				</div>
			</div>
			<div class="grid lg:grid-cols-2 gap-8 lg:gap-12 atlas-section">
				<div class="material-card atlas-card">
					<h3 class="text-3xl font-bold text-white mb-4 tracking-tight">Who We Are</h3>
					<p class="text-secondary text-lg leading-relaxed mb-6">
						We are a design studio dedicated to the art of modern instrument making. Using CAD/CAM and an engineering mindset, we craft visually artistic instruments.
					</p>
				</div>
				<div class="material-card atlas-card">
					<h3 class="text-3xl font-bold text-white mb-4 tracking-tight">What We Do</h3>
					<ul class="space-y-4 text-secondary text-lg">
						<li class="flex items-start">
							<span class="material-symbols-outlined text-accent mr-3 mt-1">check_circle</span>
							<span>Ergonomic designs for comfortable, extended play.</span>
						</li>
						<li class="flex items-start">
							<span class="material-symbols-outlined text-accent mr-3 mt-1">check_circle</span>
							<span>Choose the hardware that you are confortable.</span>
						</li>
						<li class="flex items-start">
							<span class="material-symbols-outlined text-accent mr-3 mt-1">check_circle</span>
							<span>Custom electronics to make your own unique sound.</span>
						</li>
					</ul>
				</div>
			</div>
		</div>
	}
}
