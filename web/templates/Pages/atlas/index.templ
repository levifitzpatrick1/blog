package atlas

templ Index() {
	@AtlasLayout("Atlas Basses - Custom Bass Guitars") {
		<div
			x-data="{
				showModal: !localStorage.getItem('atlas-disclaimer-seen'),
				closeModal() {
					this.showModal = false;
					localStorage.setItem('atlas-disclaimer-seen', 'true');
				}
			}"
			x-show="showModal"
			x-cloak
			class="fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-80 backdrop-blur-sm"
			@keydown.escape.window="closeModal()"
		>
			<div
				class="material-card p-12 max-w-lg mx-4 border border-border"
				@click.away="closeModal()"
				x-show="showModal"
				x-transition:enter="transition ease-out duration-300"
				x-transition:enter-start="opacity-0 transform scale-95"
				x-transition:enter-end="opacity-100 transform scale-100"
			>
				<div class="text-center">
					<span class="material-symbols-outlined text-6xl text-accent mb-6 block">
						info
					</span>
					<h2 class="text-3xl font-bold text-accent mb-6 tracking-tight">Notice</h2>
					<p class="text-secondary text-lg mb-8 leading-relaxed">
						This is not a real business, this is a student project.
					</p>
					<button
						@click="closeModal()"
						class="btn-material"
					>
						I Understand
					</button>
				</div>
			</div>
		</div>
		<div class="atlas-container">
			<div class="relative bg-cover bg-center py-20 md:py-32" style="background-image: linear-gradient(rgba(13, 17, 23, 0.7), rgba(13, 17, 23, 0.7)), url('/static/assets/index-header.jpg');">
				<div class="text-center atlas-container">
					<h1 class="text-6xl md:text-7xl lg:text-9xl font-bold text-accent mb-10 tracking-tighter atlas-heading">
						Atlas Basses
					</h1>
					<p class="text-2xl md:text-4xl text-secondary max-w-4xl mx-auto mb-8 leading-relaxed px-4 font-light">
						Custom Bass Guitars Crafted for Musicians
					</p>
					<p class="text-lg md:text-xl text-secondary/80 max-w-2xl mx-auto px-4 uppercase tracking-widest text-sm">
						Est. 2025 • Design Studio • Custom Instruments
					</p>
				</div>
			</div>
			<div class="grid lg:grid-cols-2 gap-8 lg:gap-12 atlas-section items-stretch">
				<div class="material-card atlas-card justify-center">
					<div class="mb-8">
						<span class="material-symbols-outlined text-7xl text-accent mb-4 block">
							music_note
						</span>
					</div>
					<h2 class="text-4xl md:text-5xl font-bold text-accent mb-8 tracking-tight">Custom Instruments</h2>
					<p class="text-secondary text-xl leading-relaxed mb-6">
						At Atlas Basses, we specialize in creating instruments tailored to your unique style and sound. Each bass is carefully crafted.
					</p>
					<p class="text-secondary text-xl leading-relaxed">
						Whether you're a professional musician, collector, or passionate player, we'll work with you to design the perfect instrument that matches you.
					</p>
				</div>
				<a href="/eng-website-proj/contact" class="material-card atlas-card flex flex-col justify-center bg-gradient-to-br from-accent/10 to-transparent group">
					<div class="text-center py-12">
						<p class="text-secondary text-3xl font-light tracking-wide group-hover:text-primary transition-colors">
							Your Perfect Bass Awaits <span class="material-symbols-outlined ml-2 text-lg">arrow_forward</span>
						</p>
					</div>
				</a>
			</div>
			<div class="atlas-section">
				<h2 class="text-4xl md:text-6xl font-bold text-center text-accent mb-16 lg:mb-24 tracking-tight">
					Why Choose Atlas Basses?
				</h2>
				<div class="grid md:grid-cols-3 gap-8 lg:gap-12">
					<div class="material-card atlas-card text-center">
						<span class="material-symbols-outlined text-7xl text-accent mb-8 block">
							engineering
						</span>
						<h4 class="text-2xl font-bold text-primary mb-4 tracking-tight">Engineering Mindset</h4>
						<p class="text-secondary text-lg leading-relaxed">
							Our engineering approach ensures every instrument is built to last.
						</p>
					</div>
					<div class="material-card atlas-card text-center">
						<span class="material-symbols-outlined text-7xl text-accent mb-8 block">
							palette
						</span>
						<h4 class="text-2xl font-bold text-primary mb-4 tracking-tight">Your Style</h4>
						<p class="text-secondary text-lg leading-relaxed">
							Work directly with our designers to create a bass that reflects your personal style and needs.
						</p>
					</div>
					<div class="material-card atlas-card text-center">
						<span class="material-symbols-outlined text-7xl text-accent mb-8 block">
							verified
						</span>
						<h4 class="text-2xl font-bold text-primary mb-4 tracking-tight">Quality Guarantee</h4>
						<p class="text-secondary text-lg leading-relaxed">
							We are committed to creating instruments that we can stand behind.
						</p>
					</div>
				</div>
			</div>
			<div class="grid md:grid-cols-2 gap-8 md:gap-12 atlas-section">
				<a
					href="/eng-website-proj/about"
					class="material-card atlas-card group"
				>
					<div class="mb-8">
						<span class="material-symbols-outlined text-7xl text-accent group-hover:text-primary transition-colors block">
							info
						</span>
					</div>
					<h3 class="text-4xl font-bold text-accent mb-4 group-hover:text-primary transition-colors tracking-tight">
						About Us
					</h3>
					<p class="text-secondary text-xl leading-relaxed">
						Learn about our mission and what drives us to create.
					</p>
					<div class="mt-8 flex items-center text-accent font-bold uppercase tracking-widest text-sm group-hover:text-primary transition-colors">
						Read Our Story <span class="material-symbols-outlined ml-2 text-lg">arrow_forward</span>
					</div>
				</a>
				<a
					href="/eng-website-proj/contact"
					class="material-card atlas-card group"
				>
					<div class="mb-8">
						<span class="material-symbols-outlined text-7xl text-accent group-hover:text-primary transition-colors block">
							contact_mail
						</span>
					</div>
					<h3 class="text-4xl font-bold text-accent mb-4 group-hover:text-primary transition-colors tracking-tight">
						Contact Us
					</h3>
					<p class="text-secondary text-xl leading-relaxed">
						Get in touch to discuss your custom bass project or visit our studio.
					</p>
					<div class="mt-8 flex items-center text-accent font-bold uppercase tracking-widest text-sm group-hover:text-primary transition-colors">
						Start Your Project <span class="material-symbols-outlined ml-2 text-lg">arrow_forward</span>
					</div>
				</a>
			</div>
		</div>
	}
}
